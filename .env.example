POSTGRES_DB=teamflow
POSTGRES_USER=teamflow
POSTGRES_PASSWORD=change-me-locally
RABBIT_USER=teamflow
RABBIT_PASSWORD=change-me-locally
KAFKA_USERNAME=teamflow
KAFKA_PASSWORD=change-me-locally
KAFKA_TLS_PASSWORD=change-me-locally
JWT_ISSUER=http://user-service:8081
GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:5173
USER_DB_URL=jdbc:postgresql://postgres:5432/teamflow
USER_DB_USERNAME=teamflow
USER_DB_PASSWORD=change-me-locally
JWT_ACCESS_TOKEN_TTL=PT15M
# Provide PEM files (PKCS#8 private key and X.509 public key) through local mounts.
JWT_PRIVATE_KEY_PATH=/run/secrets/teamflow-jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/teamflow-jwt-public.pem
