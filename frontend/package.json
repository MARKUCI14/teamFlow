{
  "name": "teamflow-frontend",
  "private": true,
  "type": "module",
  "workspaces": ["shell", "shared", "stakeholder", "team"],
  "scripts": {
    "dev": "concurrently -k -n shell,stakeholder,team \"npm run dev --workspace=@teamflow/shell\" \"npm run dev --workspace=@teamflow/stakeholder\" \"npm run dev --workspace=@teamflow/team\"",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.15"
  }
}
